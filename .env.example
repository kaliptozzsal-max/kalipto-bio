# TEMPLATE ONLY — this file IS committed to git. Never put real values here.
#
# Put real values in `.env.local` (git-ignored), and set the same keys in your
# Vercel project settings for production.
#
#   cp .env.example .env.local
#
# Nothing here is required for the site to build and run. Every feature that
# depends on a value below hides itself cleanly when the value is missing.

# ── Site ──────────────────────────────────────────────────────────────────────
# Absolute canonical origin, no trailing slash. Used for metadata, Open Graph
# URLs, robots.txt, the sitemap and the RSS feed.
NEXT_PUBLIC_SITE_URL=https://kalipto.dev


# ── Contact form → Telegram (recommended) ─────────────────────────────────────
# Setup:
#   1. In Telegram, message @BotFather and send /newbot
#   2. Follow the prompts; copy the token it gives you into .env.local
#   3. Open your new bot, press Start, and send it any message
#   4. Run: npm run telegram:chat-id
#   5. Copy the printed id into .env.local
#
# Treat the token like a password — anyone holding it controls the bot. It is
# read server-side only and must never be renamed to NEXT_PUBLIC_*.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ── Contact form → email (optional, runs alongside Telegram) ──────────────────
# Uses Resend (https://resend.com). Swap providers in the `sendEmail` function
# in src/app/api/contact/route.ts if you prefer a different service.
# The sender must be on a domain you have verified with the provider.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Where messages are delivered. Defaults to the email in src/data/site.ts.
CONTACT_TO_EMAIL=


# ── GitHub projects (optional) ────────────────────────────────────────────────
# The username itself lives in src/data/site.ts (`githubUsername`), not here,
# because it is public information rather than a secret.
#
# This token only raises the API rate limit from 60 to 5,000 requests per hour,
# which matters if you rebuild frequently. Create a fine-grained token at
# https://github.com/settings/tokens with NO scopes selected — the repo list it
# reads is already public.
GITHUB_TOKEN=
