# EditorConfig — https://editorconfig.org
# Keeps formatting consistent across editors without requiring a shared plugin.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown treats two trailing spaces as a hard line break, so trimming them
# would silently change rendered output.
[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

# Generated by npm — never hand-edited, so leave it exactly as written.
[package-lock.json]
insert_final_newline = unset
trim_trailing_whitespace = unset
